# ==============================================================================
# Multi-Vendor Marketplace - Production Environment Variables Template
# ==============================================================================

# --- Application Server ---
NODE_ENV=production
PORT=3000
APP_URL=https://api.marketplace.example.com
FRONTEND_URL=https://marketplace.example.com
ALLOWED_ORIGINS=https://marketplace.example.com,https://admin.marketplace.example.com

# --- Database & Connection Pool ---
# PostgreSQL connection string with SSL and connection pooling parameters
DATABASE_URL=postgresql://marketplace_user:REPLACE_WITH_SECURE_PASSWORD@marketplace-db.crw8xyz.ap-south-1.rds.amazonaws.com:5432/marketplace_prod?schema=public&sslmode=require&connection_limit=20
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20

# --- Authentication & Cryptography ---
JWT_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_HEX_SECRET_AT_LEAST_64_CHARS
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
BCRYPT_SALT_ROUNDS=12

# --- Storage Driver (Amazon S3 / Local Private) ---
# STORAGE_DRIVER: 's3' in production, 'local' in development/testing
STORAGE_DRIVER=s3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET_ACCESS_KEY
AWS_S3_DOCUMENT_BUCKET=marketplace-prod-seller-documents-ap-south-1
AWS_S3_PUBLIC_BUCKET=marketplace-prod-public-assets-ap-south-1

# --- Transactional Email (Amazon SES / Logger) ---
# EMAIL_PROVIDER: 'ses' in production, 'logger' in development/testing
EMAIL_PROVIDER=ses
AWS_SES_REGION=ap-south-1
AWS_SES_FROM_EMAIL=no-reply@marketplace.example.com
AWS_SES_CONFIGURATION_SET=marketplace-email-tracking

# --- Razorpay Payment Gateway ---
RAZORPAY_KEY_ID=rzp_live_REPLACE_WITH_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET

# --- Rate Limiting & Throttling ---
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL=900000
AUTH_THROTTLE_LIMIT=10

# --- Audit & Compliance ---
AUDIT_LOG_RETENTION_YEARS=7
