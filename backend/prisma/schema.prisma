generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  CUSTOMER
  SELLER
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
  BLOCKED
  INACTIVE
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum TokenStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

enum SellerType {
  INDIVIDUAL
  BUSINESS
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  BLOCKED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  AADHAAR
  PAN
  GST
  PHOTOGRAPH
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AddressType {
  BUSINESS
  PICKUP
  REGISTERED
}

enum SellerCategoryStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

enum CommissionStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum ProductStatus {
  ACTIVE
  PAUSED
  HIDDEN
  DELETED
}

enum CustomerAddressType {
  HOME
  WORK
  SHIPPING
  OTHER
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum StockChangeType {
  STOCK_ADDED
  STOCK_REMOVED
  RESERVATION_CREATED
  RESERVATION_CONFIRMED
  RESERVATION_RELEASED
  ORDER_DEDUCTION
  ORDER_CANCELLATION
  RETURN_RESTOCK
  MANUAL_ADJUSTMENT
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id                         String               @id @default(uuid()) @db.Uuid
  fullName                   String
  email                      String               @unique
  mobileNumber               String?              @unique
  passwordHash               String
  accountType                AccountType
  accountStatus              AccountStatus        @default(PENDING)
  emailVerified              Boolean              @default(false)
  emailVerificationHash      String?
  emailVerificationExpiresAt DateTime?
  lastLoginAt                DateTime?
  roleId                     String               @db.Uuid
  role                       Role                 @relation(fields: [roleId], references: [id])
  sessions                   Session[]
  refreshTokens              RefreshToken[]
  passwordResetTokens        PasswordResetToken[]
  sellerProfile              SellerProfile?
  customerProfile            CustomerProfile?
  reviewedSellerVerifications SellerVerification[] @relation("ReviewedSellerVerifications")
  reviewedSellerCategories   SellerCategory[]     @relation("ReviewedSellerCategories")
  createdCategories          Category[]           @relation("CreatedCategories")
  createdCategoryCommissions CategoryCommission[] @relation("CreatedCategoryCommissions")
  auditLogs                  AuditLog[]
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  @@index([accountStatus])
  @@index([roleId])
}

model Session {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         SessionStatus @default(ACTIVE)
  expiresAt      DateTime
  lastActivityAt DateTime      @default(now())
  revokedAt      DateTime?
  createdFrom    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  refreshTokens  RefreshToken[]

  @@index([userId, status])
  @@index([expiresAt])
}

model RefreshToken {
  id               String      @id @default(uuid()) @db.Uuid
  userId           String      @db.Uuid
  sessionId        String      @db.Uuid
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session          Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash        String      @unique
  status           TokenStatus @default(ACTIVE)
  expiresAt        DateTime
  revokedAt        DateTime?
  revocationReason String?
  createdAt        DateTime    @default(now())

  @@index([userId, sessionId, status])
}

model PasswordResetToken {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String      @unique
  status    TokenStatus @default(ACTIVE)
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime    @default(now())

  @@index([userId, status])
}

model SellerProfile {
  id                  String               @id @default(uuid()) @db.Uuid
  userId              String               @unique @db.Uuid
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellerType          SellerType           @default(INDIVIDUAL)
  businessName        String?
  displayName         String
  businessDescription String?
  contactEmail        String
  contactMobile       String?
  status              SellerStatus         @default(PENDING)
  payoutDetails       Json?
  addresses           SellerAddress[]
  verifications       SellerVerification[]
  sellerCategories    SellerCategory[]
  products            Product[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([status])
  @@index([sellerType])
}

model SellerVerification {
  id                    String                 @id @default(uuid()) @db.Uuid
  sellerId              String                 @db.Uuid
  seller                SellerProfile          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  submissionNumber      Int                    @default(1)
  status                VerificationStatus     @default(PENDING)
  submittedAt           DateTime               @default(now())
  reviewedAt            DateTime?
  reviewedById          String?                @db.Uuid
  reviewedBy            User?                  @relation("ReviewedSellerVerifications", fields: [reviewedById], references: [id])
  rejectionReason       String?
  notes                 String?
  verificationDocuments VerificationDocument[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([sellerId, submissionNumber])
  @@index([status])
}

model VerificationDocument {
  id             String             @id @default(uuid()) @db.Uuid
  verificationId String             @db.Uuid
  verification   SellerVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  documentType   DocumentType
  fileKey        String
  fileName       String
  mimeType       String
  fileSize       Int
  status         DocumentStatus     @default(PENDING)
  reviewRemarks  String?
  reviewedAt     DateTime?
  uploadedAt     DateTime           @default(now())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([verificationId, documentType])
  @@index([status])
}

model SellerAddress {
  id           String        @id @default(uuid()) @db.Uuid
  sellerId     String        @db.Uuid
  seller       SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  addressType  AddressType   @default(BUSINESS)
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String        @default("IN")
  isPrimary    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([sellerId, addressType])
}

model Category {
  id                 String               @id @default(uuid()) @db.Uuid
  parentCategoryId   String?              @db.Uuid
  parentCategory     Category?            @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  subcategories      Category[]           @relation("CategoryHierarchy")
  name               String
  slug               String               @unique
  description        String?
  isActive           Boolean              @default(true)
  createdById        String               @db.Uuid
  createdBy          User                 @relation("CreatedCategories", fields: [createdById], references: [id])
  commissions        CategoryCommission[]
  sellerCategories   SellerCategory[]
  products           Product[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([parentCategoryId])
  @@index([isActive])
}

model SellerCategory {
  id               String               @id @default(uuid()) @db.Uuid
  sellerId         String               @db.Uuid
  seller           SellerProfile        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId       String               @db.Uuid
  category         Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  status           SellerCategoryStatus @default(PENDING)
  requestedAt      DateTime             @default(now())
  reviewedAt       DateTime?
  reviewedById     String?              @db.Uuid
  reviewedBy       User?                @relation("ReviewedSellerCategories", fields: [reviewedById], references: [id])
  rejectionReason  String?
  revokedAt        DateTime?
  revocationReason String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([sellerId, categoryId])
  @@index([sellerId, status])
  @@index([categoryId, status])
}

model CategoryCommission {
  id             String           @id @default(uuid()) @db.Uuid
  categoryId     String           @db.Uuid
  category       Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  commissionRate Decimal          @db.Decimal(5, 2)
  effectiveFrom  DateTime         @default(now())
  effectiveTo    DateTime?
  status         CommissionStatus @default(ACTIVE)
  createdById    String           @db.Uuid
  createdBy      User             @relation("CreatedCategoryCommissions", fields: [createdById], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([categoryId, status])
  @@index([effectiveFrom, effectiveTo])
}

model Product {
  id             String                 @id @default(uuid()) @db.Uuid
  sellerId       String                 @db.Uuid
  seller         SellerProfile          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId     String                 @db.Uuid
  category       Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name           String
  description    String?
  sku            String                 @unique
  price          Decimal                @db.Decimal(10, 2)
  status         ProductStatus          @default(ACTIVE)
  deletedAt      DateTime?
  images         ProductImage[]
  specifications ProductSpecification[]
  inventory      Inventory?
  cartItems      CartItem[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([sellerId, status])
  @@index([categoryId, status])
  @@index([status])
  @@index([price])
}

model ProductImage {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @db.Uuid
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl     String
  isPrimary    Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([productId, displayOrder])
}

model ProductSpecification {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @db.Uuid
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name         String
  value        String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([productId, displayOrder])
}

model Inventory {
  id                String             @id @default(uuid()) @db.Uuid
  productId         String             @unique @db.Uuid
  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  availableQuantity Int                @default(0)
  reservedQuantity  Int                @default(0)
  lowStockThreshold Int                @default(5)
  history           InventoryHistory[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([productId])
}

model InventoryHistory {
  id               String          @id @default(uuid()) @db.Uuid
  inventoryId      String          @db.Uuid
  inventory        Inventory       @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  productId        String          @db.Uuid
  changeType       StockChangeType
  quantityChange   Int
  previousQuantity Int
  newQuantity      Int
  reason           String?
  referenceId      String?
  createdAt        DateTime        @default(now())

  @@index([inventoryId, createdAt])
  @@index([productId, createdAt])
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @db.Uuid
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String
  resourceType String
  resourceId   String
  previousValue Json?
  newValue     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model CustomerProfile {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @unique @db.Uuid
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String?
  lastName    String?
  phoneNumber String?
  addresses   CustomerAddress[]
  carts       Cart[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId])
}

model CustomerAddress {
  id                String              @id @default(uuid()) @db.Uuid
  customerId        String              @db.Uuid
  customer          CustomerProfile     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fullName          String
  phoneNumber       String
  addressLine1      String
  addressLine2      String?
  city              String
  state             String
  postalCode        String
  country           String              @default("India")
  addressType       CustomerAddressType @default(HOME)
  isDefaultShipping Boolean             @default(false)
  isDefaultBilling  Boolean             @default(false)
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([customerId, isActive])
}

model Cart {
  id         String     @id @default(uuid()) @db.Uuid
  customerId String     @db.Uuid
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status     CartStatus @default(ACTIVE)
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([customerId, status])
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @db.Uuid
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

