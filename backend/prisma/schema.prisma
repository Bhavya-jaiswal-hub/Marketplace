generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  CUSTOMER
  SELLER
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
  BLOCKED
  INACTIVE
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum TokenStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

enum SellerType {
  INDIVIDUAL
  BUSINESS
}

enum SellerStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
  BLOCKED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  AADHAAR
  PAN
  GST
  PHOTOGRAPH
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AddressType {
  BUSINESS
  PICKUP
  REGISTERED
}

enum SellerCategoryStatus {
  REQUESTED
  APPROVED
  REJECTED
  REVOKED
}

enum CommissionStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum ProductStatus {
  ACTIVE
  PAUSED
  HIDDEN
  SOFT_DELETED
  REMOVED_BY_ADMIN
}

enum CustomerAddressType {
  HOME
  WORK
  SHIPPING
  OTHER
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  PLACED
  PARTIALLY_SHIPPED
  PARTIALLY_DELIVERED
  DELIVERED
  PARTIALLY_CANCELLED
  CANCELLED
  UNDER_DISPUTE
}

enum OrderItemStatus {
  PLACED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  NOT_RECEIVED_UNDER_DISPUTE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentTransactionType {
  PAYMENT
  REFUND
  PARTIAL_REFUND
}

enum PaymentMethod {
  CARD
  NETBANKING
  UPI
  WALLET
  OTHER
}

enum ReturnRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  IN_TRANSIT
  RECEIVED
  VERIFIED
  REJECTED_ON_INSPECTION
  REFUNDED
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum RefundReason {
  RETURN
  ORDER_CANCELLATION
  DEFECTIVE_PRODUCT
  WRONG_ITEM
  ADMIN_ADJUSTMENT
  OTHER
}

enum SettlementItemStatus {
  NOT_ELIGIBLE
  ELIGIBLE
  SETTLED
}

enum SettlementBatchStatus {
  GENERATED
  APPROVED
  SETTLED
  CANCELLED
}

enum SettlementPayoutMethod {
  BANK_TRANSFER
  UPI
  MANUAL
}

enum DisputeStatus {
  NONE
  OPEN
  RESOLVED_REFUNDED
  RESOLVED_DELIVERED
}

enum DisputeResolutionOutcome {
  CUSTOMER_REFUND_UPHELD
  DISPUTE_REJECTED
}

enum AdjustmentType {
  SETTLEMENT_SHORTFALL_DEBIT
  DISPUTE_CHARGE_DEBIT
  SELLER_FAULT_RETURN_SHIPPING_DEBIT
  MANUAL_DEBIT
  MANUAL_CREDIT
  WRITE_OFF
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum AdjustmentStatus {
  PENDING
  APPLIED
  WRITTEN_OFF
  CANCELLED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum NotificationDeliveryStatus {
  QUEUED
  PROCESSING
  DELIVERED
  FAILED
}

enum TemplateStatus {
  ACTIVE
  INACTIVE
}

enum StockChangeType {
  STOCK_ADDED
  STOCK_REMOVED
  RESERVATION_CREATED
  RESERVATION_CONFIRMED
  RESERVATION_RELEASED
  ORDER_DEDUCTION
  ORDER_CANCELLATION
  RETURN_RESTOCK
  MANUAL_ADJUSTMENT
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id                         String               @id @default(uuid()) @db.Uuid
  fullName                   String
  email                      String               @unique
  mobileNumber               String?              @unique
  passwordHash               String
  accountType                AccountType
  accountStatus              AccountStatus        @default(PENDING)
  emailVerified              Boolean              @default(false)
  emailVerificationHash      String?
  emailVerificationExpiresAt DateTime?
  lastLoginAt                DateTime?
  roleId                     String               @db.Uuid
  role                       Role                 @relation(fields: [roleId], references: [id])
  sessions                   Session[]
  refreshTokens              RefreshToken[]
  passwordResetTokens        PasswordResetToken[]
  sellerProfile              SellerProfile?
  customerProfile            CustomerProfile?
  reviewedSellerVerifications SellerVerification[] @relation("ReviewedSellerVerifications")
  reviewedSellerCategories   SellerCategory[]     @relation("ReviewedSellerCategories")
  createdCategories          Category[]           @relation("CreatedCategories")
  createdCategoryCommissions CategoryCommission[] @relation("CreatedCategoryCommissions")
  takenDownProducts          Product[]            @relation("AdminProductTakedowns")
  resolvedDisputes           OrderItem[]          @relation("AdminResolvedDisputes")
  writtenOffAdjustments      SellerAdjustment[]   @relation("AdminWrittenOffAdjustments")
  auditLogs                  AuditLog[]
  notifications              Notification[]
  activityLogs               ActivityLog[]
  requestedReports           ReportMetadata[]
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  @@index([accountStatus])
  @@index([roleId])
}

model Session {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         SessionStatus @default(ACTIVE)
  expiresAt      DateTime
  lastActivityAt DateTime      @default(now())
  revokedAt      DateTime?
  createdFrom    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  refreshTokens  RefreshToken[]

  @@index([userId, status])
  @@index([expiresAt])
}

model RefreshToken {
  id               String      @id @default(uuid()) @db.Uuid
  userId           String      @db.Uuid
  sessionId        String      @db.Uuid
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session          Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash        String      @unique
  status           TokenStatus @default(ACTIVE)
  expiresAt        DateTime
  revokedAt        DateTime?
  revocationReason String?
  createdAt        DateTime    @default(now())

  @@index([userId, sessionId, status])
}

model PasswordResetToken {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String      @unique
  status    TokenStatus @default(ACTIVE)
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime    @default(now())

  @@index([userId, status])
}

model SellerProfile {
  id                  String               @id @default(uuid()) @db.Uuid
  userId              String               @unique @db.Uuid
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellerType          SellerType           @default(INDIVIDUAL)
  businessName        String?
  displayName         String
  businessDescription String?
  contactEmail        String
  contactMobile       String?
  gstin               String?
  status              SellerStatus         @default(PENDING_APPROVAL)
  payoutDetails       Json?
  addresses           SellerAddress[]
  verifications       SellerVerification[]
  sellerCategories    SellerCategory[]
  products            Product[]
  orderItems          OrderItem[]
  returnRequests      ReturnRequest[]
  settlements         Settlement[]
  settlementItems     SettlementItem[]
  adjustments         SellerAdjustment[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([status])
  @@index([sellerType])
}

model SellerVerification {
  id                    String                 @id @default(uuid()) @db.Uuid
  sellerId              String                 @db.Uuid
  seller                SellerProfile          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  submissionNumber      Int                    @default(1)
  status                VerificationStatus     @default(PENDING)
  submittedAt           DateTime               @default(now())
  reviewedAt            DateTime?
  reviewedById          String?                @db.Uuid
  reviewedBy            User?                  @relation("ReviewedSellerVerifications", fields: [reviewedById], references: [id])
  rejectionReason       String?
  notes                 String?
  verificationDocuments VerificationDocument[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([sellerId, submissionNumber])
  @@index([status])
}

model VerificationDocument {
  id             String             @id @default(uuid()) @db.Uuid
  verificationId String             @db.Uuid
  verification   SellerVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  documentType   DocumentType
  fileKey        String
  fileName       String
  mimeType       String
  fileSize       Int
  status         DocumentStatus     @default(PENDING)
  reviewRemarks  String?
  reviewedAt     DateTime?
  uploadedAt     DateTime           @default(now())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([verificationId, documentType])
  @@index([status])
}

model SellerAddress {
  id           String        @id @default(uuid()) @db.Uuid
  sellerId     String        @db.Uuid
  seller       SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  addressType  AddressType   @default(BUSINESS)
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String        @default("IN")
  isPrimary    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([sellerId, addressType])
}

model SizeSet {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @unique
  code        String         @unique
  description String?
  isActive    Boolean        @default(true)
  values      SizeSetValue[]
  categories  Category[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([code])
  @@index([isActive])
}

model SizeSetValue {
  id          String           @id @default(uuid()) @db.Uuid
  sizeSetId   String           @db.Uuid
  sizeSet     SizeSet          @relation(fields: [sizeSetId], references: [id], onDelete: Cascade)
  value       String
  displayName String
  sortOrder   Int              @default(0)
  isActive    Boolean          @default(true)
  variants    ProductVariant[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([sizeSetId, value])
  @@index([sizeSetId, sortOrder])
  @@index([isActive])
}

model Category {
  id                 String               @id @default(uuid()) @db.Uuid
  parentCategoryId   String?              @db.Uuid
  parentCategory     Category?            @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  subcategories      Category[]           @relation("CategoryHierarchy")
  name               String
  slug               String               @unique
  description        String?
  sizeSetId          String?              @db.Uuid
  sizeSet            SizeSet?             @relation(fields: [sizeSetId], references: [id], onDelete: SetNull)
  isActive           Boolean              @default(true)
  createdById        String               @db.Uuid
  createdBy          User                 @relation("CreatedCategories", fields: [createdById], references: [id])
  commissions        CategoryCommission[]
  sellerCategories   SellerCategory[]
  products           Product[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([parentCategoryId])
  @@index([sizeSetId])
  @@index([isActive])
}

model SellerCategory {
  id               String               @id @default(uuid()) @db.Uuid
  sellerId         String               @db.Uuid
  seller           SellerProfile        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId       String               @db.Uuid
  category         Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  status           SellerCategoryStatus @default(REQUESTED)
  requestedAt      DateTime             @default(now())
  reviewedAt       DateTime?
  reviewedById     String?              @db.Uuid
  reviewedBy       User?                @relation("ReviewedSellerCategories", fields: [reviewedById], references: [id])
  rejectionReason  String?
  revokedAt        DateTime?
  revocationReason String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([sellerId, categoryId])
  @@index([sellerId, status])
  @@index([categoryId, status])
}

model CategoryCommission {
  id             String           @id @default(uuid()) @db.Uuid
  categoryId     String           @db.Uuid
  category       Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  commissionRate Decimal          @db.Decimal(5, 2)
  effectiveFrom  DateTime         @default(now())
  effectiveTo    DateTime?
  status         CommissionStatus @default(ACTIVE)
  createdById    String           @db.Uuid
  createdBy      User             @relation("CreatedCategoryCommissions", fields: [createdById], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([categoryId, status])
  @@index([effectiveFrom, effectiveTo])
}

model Product {
  id                 String                 @id @default(uuid()) @db.Uuid
  sellerId           String                 @db.Uuid
  seller             SellerProfile          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId         String                 @db.Uuid
  category           Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name               String
  description        String?
  price              Decimal                @db.Decimal(10, 2)
  compareAtPrice     Decimal?               @db.Decimal(10, 2)
  status             ProductStatus          @default(ACTIVE)
  takedownReason     String?
  takedownByAdminId  String?                @db.Uuid
  takedownByAdmin    User?                  @relation("AdminProductTakedowns", fields: [takedownByAdminId], references: [id], onDelete: SetNull)
  deletedAt          DateTime?
  images             ProductImage[]
  specifications     ProductSpecification[]
  variants           ProductVariant[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([sellerId, status])
  @@index([categoryId, status])
  @@index([status])
  @@index([price])
  @@index([takedownByAdminId])
}

model ProductVariant {
  id                String             @id @default(uuid()) @db.Uuid
  productId         String             @db.Uuid
  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizeSetValueId    String?            @db.Uuid
  sizeSetValue      SizeSetValue?      @relation(fields: [sizeSetValueId], references: [id], onDelete: SetNull)
  sku               String             @unique
  size              String
  color             String
  stockQuantity     Int                @default(0)
  lowStockThreshold Int                @default(5)
  priceOverride     Decimal?           @db.Decimal(10, 2)
  isActive          Boolean            @default(true)
  cartItems         CartItem[]
  orderItems        OrderItem[]
  images            ProductImage[]
  inventory         Inventory?
  inventoryHistory  InventoryHistory[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([productId, size, color])
  @@index([productId, isActive])
  @@index([sku])
  @@index([sizeSetValueId])
}

model ProductImage {
  id           String          @id @default(uuid()) @db.Uuid
  productId    String          @db.Uuid
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId    String?         @db.Uuid
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  imageUrl     String
  isPrimary    Boolean         @default(false)
  displayOrder Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([productId, displayOrder])
  @@index([variantId])
}

model ProductSpecification {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @db.Uuid
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name         String
  value        String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([productId, displayOrder])
}

model Inventory {
  id                String             @id @default(uuid()) @db.Uuid
  variantId         String             @unique @db.Uuid
  variant           ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  availableQuantity Int                @default(0)
  reservedQuantity  Int                @default(0)
  lowStockThreshold Int                @default(5)
  history           InventoryHistory[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([variantId])
}

model InventoryHistory {
  id               String          @id @default(uuid()) @db.Uuid
  inventoryId      String          @db.Uuid
  inventory        Inventory       @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  variantId        String          @db.Uuid
  variant          ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  changeType       StockChangeType
  quantityChange   Int
  previousQuantity Int
  newQuantity      Int
  reason           String?
  referenceId      String?
  createdAt        DateTime        @default(now())

  @@index([inventoryId, createdAt])
  @@index([variantId, createdAt])
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @db.Uuid
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String
  resourceType String
  resourceId   String
  previousValue Json?
  newValue     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model CustomerProfile {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @unique @db.Uuid
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String?
  lastName    String?
  phoneNumber String?
  addresses           CustomerAddress[]
  carts               Cart[]
  orders              Order[]
  paymentsPending     PaymentPending[]
  paymentTransactions PaymentTransaction[]
  returnRequests      ReturnRequest[]
  refunds             Refund[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([userId])
}

model CustomerAddress {
  id                  String              @id @default(uuid()) @db.Uuid
  customerId          String              @db.Uuid
  customer            CustomerProfile     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fullName            String
  phoneNumber         String
  addressLine1        String
  addressLine2        String?
  city                String
  state               String
  postalCode          String
  country             String              @default("India")
  addressType         CustomerAddressType @default(HOME)
  isDefaultShipping   Boolean             @default(false)
  isDefaultBilling    Boolean             @default(false)
  isActive            Boolean             @default(true)
  orders              Order[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([customerId, isActive])
}

model Cart {
  id         String     @id @default(uuid()) @db.Uuid
  customerId String     @db.Uuid
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status     CartStatus @default(ACTIVE)
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([customerId, status])
}

model CartItem {
  id        String          @id @default(uuid()) @db.Uuid
  cartId    String          @db.Uuid
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String          @db.Uuid
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String         @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([productId])
  @@index([variantId])
}

model Order {
  id                      String               @id @default(uuid()) @db.Uuid
  customerId              String               @db.Uuid
  customer                CustomerProfile      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orderNumber             String               @unique
  shippingAddressId       String?              @db.Uuid
  shippingAddress         CustomerAddress?     @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  shippingAddressSnapshot Json
  orderStatus             OrderStatus          @default(PLACED)
  paymentStatus           PaymentStatus        @default(PENDING)
  currency                String               @default("INR")
  subtotal                Decimal              @db.Decimal(10, 2)
  shippingAmount          Decimal              @default(0.00) @db.Decimal(10, 2)
  discountAmount          Decimal              @default(0.00) @db.Decimal(10, 2)
  taxAmount               Decimal              @default(0.00) @db.Decimal(10, 2)
  totalAmount             Decimal              @db.Decimal(10, 2)
  orderItems              OrderItem[]
  paymentsPending         PaymentPending[]
  paymentTransactions     PaymentTransaction[]
  returnRequests          ReturnRequest[]
  refunds                 Refund[]
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@index([customerId, orderStatus])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([orderNumber])
  @@index([createdAt])
}

model OrderItem {
  id                     String                    @id @default(uuid()) @db.Uuid
  orderId                String                    @db.Uuid
  order                  Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId              String                    @db.Uuid
  product                Product                   @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId              String                    @db.Uuid
  variant                ProductVariant            @relation(fields: [variantId], references: [id], onDelete: Restrict)
  sellerId               String                    @db.Uuid
  seller                 SellerProfile             @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  productName            String
  sku                    String
  courierName            String?
  trackingCarrier        String?
  trackingNumber         String?
  shippedAt              DateTime?
  deliveredAt            DateTime?
  productNameSnapshot    String?
  skuSnapshot            String?
  sizeSnapshot           String?
  colorSnapshot          String?
  unitPrice              Decimal                   @db.Decimal(10, 2)
  quantity               Int
  subtotal               Decimal                   @db.Decimal(10, 2)
  discountAmount         Decimal                   @default(0.00) @db.Decimal(10, 2)
  taxAmount              Decimal                   @default(0.00) @db.Decimal(10, 2)
  totalAmount            Decimal                   @db.Decimal(10, 2)
  commissionRate         Decimal                   @db.Decimal(5, 2)
  commissionAmount       Decimal                   @db.Decimal(10, 2)
  shippingFeeShare       Decimal                   @default(0.00) @db.Decimal(10, 2)
  sellerEarnings         Decimal                   @db.Decimal(10, 2)
  status                 OrderItemStatus           @default(PLACED)
  notReceivedReportedAt  DateTime?
  disputeStatus          DisputeStatus             @default(NONE)
  slaDueAt               DateTime?
  sellerProofNotes       String?
  sellerProofDocumentUrl String?
  resolutionOutcome      DisputeResolutionOutcome?
  resolvedById           String?                   @db.Uuid
  resolvedBy             User?                     @relation("AdminResolvedDisputes", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt             DateTime?
  disputeAdminNotes      String?
  cancelledAt            DateTime?
  cancellationReason     String?
  history                OrderItemHistory[]
  returnRequests         ReturnRequest[]
  refunds                Refund[]
  settlementItem         SettlementItem?
  adjustments            SellerAdjustment[]
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  @@index([orderId])
  @@index([sellerId, status])
  @@index([productId])
  @@index([variantId])
  @@index([status])
  @@index([disputeStatus])
}

model OrderItemHistory {
  id             String           @id @default(uuid()) @db.Uuid
  orderItemId    String           @db.Uuid
  orderItem      OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  previousStatus OrderItemStatus?
  newStatus      OrderItemStatus
  eventType      String
  reason         String?
  changedBy      String?
  createdAt      DateTime         @default(now())

  @@index([orderItemId, createdAt])
}

model PaymentPending {
  id                     String          @id @default(uuid()) @db.Uuid
  orderId                String          @db.Uuid
  order                  Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId             String          @db.Uuid
  customer               CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  paymentReference       String          @unique
  providerOrderReference String?
  amount                 Decimal         @db.Decimal(10, 2)
  currency               String          @default("INR")
  paymentMethod          PaymentMethod   @default(CARD)
  status                 PaymentStatus   @default(PENDING)
  attemptNumber          Int             @default(1)
  idempotencyKey         String?         @unique
  expiresAt              DateTime
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([orderId])
  @@index([customerId, status])
  @@index([paymentReference])
}

model PaymentTransaction {
  id                    String                   @id @default(uuid()) @db.Uuid
  orderId               String                   @db.Uuid
  order                 Order                    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customerId            String                   @db.Uuid
  customer              CustomerProfile          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  paymentReference      String                   @unique
  providerTransactionId String                   @unique
  amount                Decimal                  @db.Decimal(10, 2)
  currency              String                   @default("INR")
  paymentMethod         String                   @default("RAZORPAY")
  status                PaymentTransactionStatus @default(SUCCEEDED)
  transactionType       PaymentTransactionType   @default(PAYMENT)
  rawWebhookPayload     Json?
  refunds               Refund[]
  processedAt           DateTime                 @default(now())
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([orderId])
  @@index([customerId])
  @@index([providerTransactionId])
  @@index([status])
}

model ReturnRequest {
  id                   String              @id @default(uuid()) @db.Uuid
  orderId              String              @db.Uuid
  order                Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItemId          String              @db.Uuid
  orderItem            OrderItem           @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  customerId           String              @db.Uuid
  customer             CustomerProfile     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sellerId             String              @db.Uuid
  seller               SellerProfile       @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  returnQuantity       Int                 @default(1)
  reason               String
  customerComments     String?
  status               ReturnRequestStatus @default(REQUESTED)
  sellerComments       String?
  adminRemarks         String?
  rejectionReason      String?
  pickupCarrier        String?
  pickupTrackingNumber String?
  pickupScheduledAt    DateTime?
  receivedAt           DateTime?
  completedAt          DateTime?
  refund               Refund?
  adjustments          SellerAdjustment[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([orderId])
  @@index([orderItemId])
  @@index([customerId, status])
  @@index([sellerId, status])
  @@index([status])
}

model Refund {
  id                   String              @id @default(uuid()) @db.Uuid
  orderId              String              @db.Uuid
  order                Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItemId          String?             @db.Uuid
  orderItem            OrderItem?          @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  returnRequestId      String?             @unique @db.Uuid
  returnRequest        ReturnRequest?      @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)
  customerId           String              @db.Uuid
  customer             CustomerProfile     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  paymentTransactionId String?             @db.Uuid
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)
  refundAmount         Decimal             @db.Decimal(10, 2)
  currency             String              @default("INR")
  refundReason         String
  status               RefundStatus        @default(PENDING)
  providerRefundId     String?             @unique
  processedById        String?             @db.Uuid
  failureReason        String?
  rawResponse          Json?
  processedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([orderId])
  @@index([customerId, status])
  @@index([status])
  @@index([providerRefundId])
}

model Settlement {
  id                      String                 @id @default(uuid()) @db.Uuid
  settlementNumber        String                 @unique
  sellerId                String                 @db.Uuid
  seller                  SellerProfile          @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  periodFrom              DateTime
  periodTo                DateTime
  grossAmount             Decimal                @db.Decimal(10, 2)
  commissionAmount        Decimal                @db.Decimal(10, 2)
  refundDeductions        Decimal                @default(0.00) @db.Decimal(10, 2)
  adjustmentAmount        Decimal                @default(0.00) @db.Decimal(10, 2)
  netSettlementAmount     Decimal                @db.Decimal(10, 2)
  currency                String                 @default("INR")
  status                  SettlementBatchStatus  @default(GENERATED)
  payoutMethod            SettlementPayoutMethod @default(BANK_TRANSFER)
  payoutReference         String?
  payoutNotes             String?
  processedById           String?                @db.Uuid
  bankSnapshot            Json?
  processedAt             DateTime?
  items                   SettlementItem[]
  originatingAdjustments  SellerAdjustment[]     @relation("OriginatingSettlement")
  appliedAdjustments      SellerAdjustment[]     @relation("AppliedSettlement")
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@index([sellerId, status])
  @@index([settlementNumber])
  @@index([status])
  @@index([createdAt])
}

model SettlementItem {
  id               String        @id @default(uuid()) @db.Uuid
  settlementId     String        @db.Uuid
  settlement       Settlement    @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  orderItemId      String        @unique @db.Uuid
  orderItem        OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  sellerId         String        @db.Uuid
  seller           SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  grossAmount      Decimal       @db.Decimal(10, 2)
  commissionRate   Decimal       @db.Decimal(5, 2)
  commissionAmount Decimal       @db.Decimal(10, 2)
  refundAmount     Decimal       @default(0.00) @db.Decimal(10, 2)
  adjustmentAmount Decimal       @default(0.00) @db.Decimal(10, 2)
  netAmount        Decimal              @db.Decimal(10, 2)
  status           SettlementItemStatus @default(NOT_ELIGIBLE)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([settlementId])
  @@index([sellerId])
  @@index([orderItemId])
  @@index([status])
}

model SellerAdjustment {
  id                      String           @id @default(uuid()) @db.Uuid
  sellerId                String           @db.Uuid
  seller                  SellerProfile    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  type                    AdjustmentType
  amount                  Decimal          @db.Decimal(10, 2)
  direction               LedgerDirection
  status                  AdjustmentStatus @default(PENDING)
  reason                  String
  orderItemId             String?          @db.Uuid
  orderItem               OrderItem?       @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  returnRequestId         String?          @db.Uuid
  returnRequest           ReturnRequest?   @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)
  originatingSettlementId String?          @db.Uuid
  originatingSettlement   Settlement?      @relation("OriginatingSettlement", fields: [originatingSettlementId], references: [id], onDelete: SetNull)
  appliedInSettlementId   String?          @db.Uuid
  appliedInSettlement     Settlement?      @relation("AppliedSettlement", fields: [appliedInSettlementId], references: [id], onDelete: SetNull)
  appliedAt               DateTime?
  isWrittenOff            Boolean          @default(false)
  writtenOffById          String?          @db.Uuid
  writtenOffBy            User?            @relation("AdminWrittenOffAdjustments", fields: [writtenOffById], references: [id], onDelete: SetNull)
  writtenOffAt            DateTime?
  writtenOffReason        String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@index([sellerId, status])
  @@index([type])
  @@index([orderItemId])
  @@index([returnRequestId])
  @@index([originatingSettlementId])
  @@index([appliedInSettlementId])
}

model Notification {
  id               String                     @id @default(uuid()) @db.Uuid
  userId           String                     @db.Uuid
  user             User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             String
  title            String
  message          String
  referenceType    String?
  referenceId      String?
  channel          NotificationChannel        @default(IN_APP)
  status           NotificationDeliveryStatus @default(DELIVERED)
  isRead           Boolean                    @default(false)
  readAt           DateTime?
  deliveryAttempts Int                        @default(1)
  failureReason    String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@index([userId, isRead])
  @@index([userId, type])
  @@index([status])
  @@index([createdAt])
}

model NotificationTemplate {
  id              String              @id @default(uuid()) @db.Uuid
  templateName    String              @unique
  notificationType String
  titleTemplate   String
  messageTemplate String
  channel         NotificationChannel @default(IN_APP)
  status          TemplateStatus      @default(ACTIVE)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([notificationType, channel])
  @@index([status])
}

model ActivityLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @db.Uuid
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  activityType String
  description  String
  resourceType String?
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([activityType])
  @@index([createdAt])
}

model ReportMetadata {
  id             String    @id @default(uuid()) @db.Uuid
  reportName     String
  reportType     String
  requestedById  String    @db.Uuid
  requestedBy    User      @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  reportFormat   String    @default("CSV")
  periodFrom     DateTime?
  periodTo       DateTime?
  status         String    @default("COMPLETED")
  fileKey        String?
  filterParams   Json?
  summaryMetrics Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([requestedById, reportType])
  @@index([reportType])
  @@index([createdAt])
}


